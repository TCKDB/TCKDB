# ============================================================================
# TCKDB - canonical Compose env template (local developer scenario)
#
# Copy to .env at the repo root:
#     cp .env.example .env
#
# Compose reads .env from the repo root automatically. This file only
# contains the variables that docker-compose.yml interpolates. Backend
# application settings (rate limits, auth policy, etc.) live separately
# in backend/.env (see backend/.env.example).
#
# For a hardened single-node server deployment, use .env.selfhosted.example
# instead and pass `--env-file .env.selfhosted` to docker compose. See
# docs/deployment/self_hosted_single_node.md.
# ============================================================================

# -- PostgreSQL (with RDKit cartridge) ---------------------------------------
# DB_USER, DB_NAME, DB_PORT have soft defaults in docker-compose.yml so a
# fresh checkout boots with `tckdb` / `tckdb_dev` on :5432. Override here
# if you collide with a host-installed Postgres.
#
# DB_PASSWORD is REQUIRED. Compose refuses to start without it.
DB_USER=tckdb
DB_PASSWORD=tckdb
DB_NAME=tckdb_dev
DB_PORT=5432

# -- S3 artifact storage (SeaweedFS by default) -----------------------------
# S3_ACCESS_KEY has a soft default; S3_SECRET_KEY is REQUIRED. Compose
# hands both to the seaweedfs service as its admin identity.
S3_ACCESS_KEY=tckdb
S3_SECRET_KEY=tckdb_secret

# Signs the tokens the SeaweedFS filer and volume server require before they
# read or write file content, which is what keeps other containers on the
# compose network out of the store's unauthenticated internal ports (#545).
# REQUIRED by the seaweedfs service: it refuses to start (exit 78) without
# one of at least 16 characters. A stack that runs only MinIO can leave it
# unset. Only the seaweedfs container uses it; the API never needs it.
# Generate one with
#     openssl rand -hex 32
SEAWEEDFS_JWT_KEY=tckdb-local-dev-seaweedfs-jwt-key

# How long /status believes a bucket quota before re-asking MinIO's admin
# API, in seconds. Applies to MinIO deployments only; other stores have no
# such API and /status simply reports no quota. Optional; the default below is what the code uses if
# the variable is unset, and a quota changes about once a year, so there
# is rarely a reason to touch it. Lower it if you are testing a quota
# change and do not want to wait for /status to notice. A non-numeric or
# negative value is ignored and logged.
# TCKDB_STORAGE_QUOTA_TTL_SECONDS=300
