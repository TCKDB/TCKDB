{
  "$defs": {
    "DepositRights": {
      "additionalProperties": false,
      "description": "Deposit-time agreement that the records may be licensed as stated.",
      "properties": {
        "depositor_attests_right_to_license": {
          "const": true,
          "title": "Depositor Attests Right To License",
          "type": "boolean"
        },
        "license": {
          "maxLength": 64,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "source_terms": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Terms"
        }
      },
      "required": [
        "license",
        "depositor_attests_right_to_license"
      ],
      "title": "DepositRights",
      "type": "object"
    },
    "MoleculeKind": {
      "enum": [
        "molecule",
        "pseudo",
        "electron"
      ],
      "title": "MoleculeKind",
      "type": "string"
    },
    "ReactionParticipantUpload": {
      "additionalProperties": false,
      "description": "Workflow-facing ordered participant slot for a reaction entry.\n\n:param species_entry_id: Existing species-entry id to reuse directly.\n:param species_entry: Species-entry identity payload to resolve or create.\n:param note: Optional note stored on the structured participant row.",
      "properties": {
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "species_entry": {
          "anyOf": [
            {
              "$ref": "#/$defs/SpeciesEntryIdentityPayload"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "species_entry_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Species Entry Id"
        }
      },
      "title": "ReactionParticipantUpload",
      "type": "object"
    },
    "SpeciesEntryIdentityPayload": {
      "additionalProperties": false,
      "description": "Reusable upload fragment for resolved species-entry identity.\n\n:param species_entry_kind: Stationary-point kind for the resolved entry.\n:param unmapped_smiles: Optional display/search SMILES for the resolved entry.\n:param stereo_kind: Stereo classification for the resolved entry.\n:param stereo_label: Optional stereo label such as ``R`` or ``E``.\n:param electronic_state_kind: Electronic-state classification.\n:param electronic_state_label: Optional state label such as ``X`` or ``A``.\n:param term_symbol_raw: Optional raw uploaded term symbol.\n:param term_symbol: Optional canonicalized term symbol.\n\nIsotopic resolution is *not* a field on this payload. It is derived\nserver-side from the atom-resolved isotope labels in ``smiles`` (see\n``SpeciesIdentityPayload.smiles``). The former free-text\n``isotopologue_label`` has been removed: an arbitrary string could mint\ntwo species identities that no scientific content distinguished, and a\nderived key may never be accepted from an uploader.",
      "properties": {
        "charge": {
          "title": "Charge",
          "type": "integer"
        },
        "electronic_state_kind": {
          "$ref": "#/$defs/SpeciesEntryStateKind",
          "default": "ground"
        },
        "electronic_state_label": {
          "anyOf": [
            {
              "maxLength": 8,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Electronic State Label"
        },
        "molecule_kind": {
          "$ref": "#/$defs/MoleculeKind",
          "default": "molecule"
        },
        "multiplicity": {
          "minimum": 1,
          "title": "Multiplicity",
          "type": "integer"
        },
        "smiles": {
          "minLength": 1,
          "title": "Smiles",
          "type": "string"
        },
        "species_entry_kind": {
          "$ref": "#/$defs/StationaryPointKind",
          "default": "minimum"
        },
        "stereo_kind": {
          "$ref": "#/$defs/StereoKind",
          "default": "unspecified"
        },
        "stereo_label": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stereo Label"
        },
        "term_symbol": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term Symbol"
        },
        "term_symbol_raw": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Term Symbol Raw"
        },
        "unmapped_smiles": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unmapped Smiles"
        }
      },
      "required": [
        "smiles",
        "charge",
        "multiplicity"
      ],
      "title": "SpeciesEntryIdentityPayload",
      "type": "object"
    },
    "SpeciesEntryStateKind": {
      "enum": [
        "ground",
        "excited"
      ],
      "title": "SpeciesEntryStateKind",
      "type": "string"
    },
    "StationaryPointKind": {
      "enum": [
        "minimum",
        "vdw_complex"
      ],
      "title": "StationaryPointKind",
      "type": "string"
    },
    "StereoKind": {
      "enum": [
        "unspecified",
        "achiral",
        "enantiomer",
        "diastereomer",
        "ez_isomer"
      ],
      "title": "StereoKind",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Workflow-facing reaction upload payload.\n\nThe backend resolves the graph identity into ``ChemReaction`` and\n``ReactionParticipant`` rows, then creates a new ``ReactionEntry`` with\nordered structured participants for the resolved species-entry forms.\n\n:param reversible: Whether the uploaded reaction is reversible.\n:param reaction_family: Optional reaction-family label.\n:param reaction_family_source_note: Required when ``reaction_family`` is not a supported canonical family.\n:param reactants: Ordered structured participants on the reactant side.\n:param products: Ordered structured participants on the product side.",
  "examples": [
    {
      "products": [
        {
          "species_entry": {
            "charge": 0,
            "multiplicity": 1,
            "smiles": "[H][H]"
          }
        }
      ],
      "reactants": [
        {
          "species_entry": {
            "charge": 0,
            "multiplicity": 2,
            "smiles": "[H]"
          }
        },
        {
          "species_entry": {
            "charge": 0,
            "multiplicity": 2,
            "smiles": "[H]"
          }
        }
      ],
      "reversible": true
    }
  ],
  "properties": {
    "products": {
      "items": {
        "$ref": "#/$defs/ReactionParticipantUpload"
      },
      "minItems": 1,
      "title": "Products",
      "type": "array"
    },
    "reactants": {
      "items": {
        "$ref": "#/$defs/ReactionParticipantUpload"
      },
      "minItems": 1,
      "title": "Reactants",
      "type": "array"
    },
    "reaction_family": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reaction Family"
    },
    "reaction_family_source_note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reaction Family Source Note"
    },
    "reversible": {
      "title": "Reversible",
      "type": "boolean"
    },
    "rights": {
      "anyOf": [
        {
          "$ref": "#/$defs/DepositRights"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "reversible",
    "reactants",
    "products"
  ],
  "title": "ReactionUploadRequest",
  "type": "object"
}
