# ============================================================================
# TCKDB - Lab-server deployment environment (EXAMPLE / PLACEHOLDERS ONLY)
#
# Reference env file for a private shared lab-server deployment.  Copy to
# .env on the lab service host and replace every placeholder before use:
#
#   cp examples/deployment/lab-server.env.example .env
#
# This file contains NO secrets.  Every credential below is a placeholder
# (`change-me`, `replace-me`, etc.) and must be replaced before the server
# is started.  Do NOT commit the resulting .env back to the repo.
#
# This is the lab-server analogue of `.env.local.example`.  Differences:
#   - Open registration is OFF.
#   - The API binds to 0.0.0.0 (reachable behind the reverse proxy).
#   - TCKDB_PUBLIC_BASE_URL is set to the lab-visible URL.
#
# See: docs/deployment/shared-private-deployment.md
# ============================================================================

# -- PostgreSQL (with RDKit cartridge) ---------------------------------------
# These are the restricted API/worker credentials. Keep the administrator and
# migration-owner credentials in a separate operator-only file based on
# `.env.db-admin.example`; never load that file into the API process.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tckdb_lab
DB_USER=tckdb_app
DB_PASSWORD=change-me-strong-runtime-db-password
DB_CLIENT_ENCODING=utf8

# -- S3 artifact storage ----------------------------------------------------
# Either keep SeaweedFS on the same host (default, from docker-compose.yml)
# or point S3_ENDPOINT_URL at a lab-managed S3-compatible service.  Replace
# the access keys with strong values.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=replace-me-s3-access
S3_SECRET_KEY=replace-me-s3-secret
S3_BUCKET=tckdb-artifacts
S3_REGION=us-east-1

# Signs the tokens the SeaweedFS filer and volume server require before they
# read or write file content, which is what keeps other containers on the
# compose network out of the store's unauthenticated internal ports (#545).
# REQUIRED by the seaweedfs service: it refuses to start (exit 78) without
# one of at least 16 characters. A stack that runs only MinIO can leave it
# unset. Only the seaweedfs container uses it; the API never needs it.
# Generate one with
#     openssl rand -hex 32
SEAWEEDFS_JWT_KEY=replace-me-openssl-rand-hex-32

# Optional. The SeaweedFS master, which the API asks for free disk and free
# volume slots after a write is refused with SeaweedFS's generic
# InternalError, and for the /status headroom warning. Unset, a full
# SeaweedFS is reported as "unavailable, retry later" (503) rather than full
# (507), and /status cannot warn before it fills. Set it only when the store
# is the `seaweedfs` service: the volume server is derived from it (same
# host, port 9340). An API container reaches it by service name once it is
# on the `<project>_storage` network (tckdb_deploy.sh: TCKDB_EXTRA_NETWORKS);
# an API on the host would need 9333 and 9340 published on 127.0.0.1, which
# docker-compose.yml does not do.
# S3_SEAWEEDFS_MASTER_URL=http://seaweedfs:9333

# Optional, read by backend/scripts/ops/tckdb_deploy.sh: extra Docker
# networks the API container joins. The bundled object store is reachable
# only on the `storage` network, so a containerised API using it needs:
# TCKDB_EXTRA_NETWORKS=tckdbv2_storage

# -- Authentication / registration policy ------------------------------------
# Shared lab-server deployments MUST disable open registration.  Seed
# accounts with scripts/bootstrap_admin.py instead.  Re-enabling this on a
# reachable server is a soft account-creation backdoor - don't.
AUTH_ALLOW_OPEN_REGISTRATION=false

# -- Upload worker -----------------------------------------------------------
# Inline worker is fine for a small lab; flip to false and run
# `python -m app.workers.upload_worker` under systemd if you want isolation.
TCKDB_INLINE_WORKER=true

# -- Backend API binding -----------------------------------------------------
# Bind to all interfaces; the reverse proxy is what the network sees.  The
# proxy is responsible for TLS termination, X-API-Key passthrough, and
# preserving the session cookie.
TCKDB_API_HOST=0.0.0.0
TCKDB_API_PORT=8010

# Public base URL the lab uses to reach this deployment.  Clients (scripts,
# notebooks, HPC jobs) configure this as their TCKDB_BASE_URL.
TCKDB_PUBLIC_BASE_URL=https://tckdb.lab.example.org/api/v1
