# TCKDB database operator credentials (HOSTED DEPLOYMENTS ONLY)
#
# backend/scripts/ops/tckdb_make_env.sh writes .env.db-admin from this file
# with every secret generated. By hand: copy to .env.db-admin, replace every
# change-me value, and chmod 600. Never load this file into the API or worker
# process. Operators pass it to Docker Compose for database bootstrap (the
# selfhost profile hands it to the one-shot `init` service only) and source it
# only while provisioning roles, running Alembic, or performing privileged
# recovery.

# ----------------------------------------------------------------------------
# Must set
# ----------------------------------------------------------------------------
DB_ADMIN_PASSWORD=change-me-strong-admin-password
DB_OWNER_PASSWORD=change-me-strong-owner-password

# The first administrator, created by the selfhost `init` service. The
# password is needed only while the account does not exist yet; it may be
# removed after the first start. Unused outside the selfhost profile.
TCKDB_BOOTSTRAP_USERNAME=admin
TCKDB_BOOTSTRAP_EMAIL=
TCKDB_BOOTSTRAP_PASSWORD=

# ----------------------------------------------------------------------------
# Roles
# ----------------------------------------------------------------------------
# Cluster bootstrap/recovery account.  The PostgreSQL container creates this
# role as a superuser on a fresh volume.  It is not used by TCKDB application
# code and should not own application schema objects after provisioning.
DB_ADMIN_USER=tckdb_admin

# Non-superuser owner of the TCKDB database, public schema, tables, sequences,
# functions, and application enum/domain types.  Alembic uses this account.
DB_OWNER_USER=tckdb_owner
