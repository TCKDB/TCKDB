# TCKDB database operator credentials (.env.db-admin). Never give this file to the API or worker.
# Write it with backend/scripts/ops/tckdb_make_env.sh, which fills every secret. Do not commit the result.
# Passwords are set on the roles when the volume is created. To change one, change the role first:
#   docker compose --env-file .env.selfhosted --env-file .env.db-admin exec db \
#       psql -U <DB_ADMIN_USER> -d <DB_NAME> -c "ALTER ROLE <role> PASSWORD '<new>'"

# --- Secrets (generated by tckdb_make_env.sh; do not commit) ---
DB_ADMIN_PASSWORD=change-me-strong-admin-password
DB_OWNER_PASSWORD=change-me-strong-owner-password

# --- First administrator, created by the selfhost init service ---
TCKDB_BOOTSTRAP_USERNAME=admin
TCKDB_BOOTSTRAP_EMAIL=
# Needed only until the account exists; may be removed after the first start.
TCKDB_BOOTSTRAP_PASSWORD=

# --- Roles ---
# Superuser for bootstrap and recovery, created on a fresh volume.
DB_ADMIN_USER=tckdb_admin

# Owner of the schema; Alembic runs as this role.
DB_OWNER_USER=tckdb_owner
