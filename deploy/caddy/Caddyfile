# HTTPS in front of the TCKDB web UI, for the `caddy` compose profile.
# Settings come from .env.selfhosted; the compose entrypoint sets
# TCKDB_CADDY_TLS to the name of one of the snippets below.

# Let's Encrypt, no contact address.
(tls_acme) {
}

# Let's Encrypt, with TCKDB_ACME_EMAIL as the contact address.
(tls_acme_email) {
	tls {$TCKDB_ACME_EMAIL}
}

# Caddy's own certificate authority. Browsers do not trust it.
(tls_internal) {
	tls internal
}

{$TCKDB_DOMAIN} {
	import tls_{$TCKDB_CADDY_TLS}

	encode zstd gzip

	# Replace X-Real-IP, never append, so a client cannot pick the address
	# the API rate-limits.
	reverse_proxy frontend:8080 {
		header_up X-Real-IP {remote_host}
	}
}
