# HTTPS in front of the TCKDB web UI, for the `caddy` compose profile.
#
# The values come from .env.selfhosted through docker-compose.yml:
#   TCKDB_DOMAIN      the domain name this server answers to (required)
#   TCKDB_ACME_EMAIL  contact address for the certificate authority (optional)
#   TCKDB_TLS         `internal` for Caddy's own certificate authority (testing)

# Let's Encrypt, no contact address.
(tls_acme) {
}

# Let's Encrypt, with TCKDB_ACME_EMAIL as the contact address.
(tls_acme_email) {
	tls {$TCKDB_ACME_EMAIL}
}

# Caddy's own certificate authority. Browsers do not trust it.
(tls_internal) {
	tls internal
}

{$TCKDB_DOMAIN} {
	import tls_{$TCKDB_CADDY_TLS:acme}

	encode zstd gzip

	# The web UI passes /api/ on to the API. X-Real-IP is replaced, never
	# appended to, so a client cannot choose the address the API rate-limits.
	reverse_proxy frontend:8080 {
		header_up X-Real-IP {remote_host}
	}
}
