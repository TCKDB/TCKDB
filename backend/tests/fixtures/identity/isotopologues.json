  },
  {
    "id": "isotopologues/geometry_isotopes_without_identity_rejected",
    "description": "Ordinary methanol identity with a deuterated geometry.",
    "inputs": [
      {
        "smiles": "CO",
        "charge": 0,
        "multiplicity": 1,
        "geometry": {
          "xyz_text": "6\n\nC  -0.047131  0.664389  0.000000\nO  -0.047131 -0.758551  0.000000\nH  -1.092995  0.969785  0.000000\nH   0.878534 -1.048458  0.000000\nH   0.437145  1.080376  0.891772\nH   0.437145  1.080376 -0.891772\n",
          "isotopes": {
            "3": 2,
            "5": 2,
            "6": 2
          }
        }
      }
    ],
    "expected": "rejected",
    "rejection": {
