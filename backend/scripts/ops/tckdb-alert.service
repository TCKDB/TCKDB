[Unit]
Description=TCKDB health check with ntfy push on state change
After=network-online.target
Wants=network-online.target

# Pushes an alert when this checker itself fails.
OnFailure=tckdb-alert-failed.service

[Service]
Type=oneshot

# Holds TCKDB_NTFY_TOPIC (a secret). No leading `-`: a missing file must fail
# this unit so OnFailure= fires.
EnvironmentFile=/home/YOUR_USER/.config/tckdb-alert.env
ExecStart=/opt/tckdb/backend/scripts/ops/tckdb_alert_check.sh

# 1 means "unhealthy", reported by the script. Never add 2: that is the
# script dying before a verdict, which must fail the unit.
SuccessExitStatus=0 1

User=YOUR_USER
