[Unit]
Description=Close the TCKDB object store's internal ports to this host
# Install, verify and remove: docs/deployment/storage-firewall.md.
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes

# Name the network only if Compose made more than one `storage` network here.
#Environment=TCKDB_STORAGE_NETWORK=tckdb_storage
#
# Container ports left open (default 9000, the S3 gateway). Never add a gRPC port.
#Environment=TCKDB_STORAGE_ALLOW_PORTS=9000

# Runs as root: use a root-owned copy of the script, and re-copy it after an upgrade.
ExecStart=/usr/local/sbin/tckdb_storage_hostfw.sh --wait 60

[Install]
WantedBy=multi-user.target
