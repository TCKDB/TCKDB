# ============================================================================
# TCKDB - Self-hosted single-node deployment environment
# (EXAMPLE / PLACEHOLDERS)
#
# Generate .env.selfhosted and .env.db-admin with every secret filled in:
#   backend/scripts/ops/tckdb_make_env.sh
# Or by hand: copy both templates and replace every `change-me-*` value:
#   cp .env.selfhosted.example .env.selfhosted
#   cp .env.db-admin.example .env.db-admin
# Do NOT commit the resulting files. The API loads only .env.selfhosted; in
# shared_private and hosted_public it refuses to start while a secret below
# is empty or still a change-me value.
#
# Reference doc: docs/deployment/self_hosted_single_node.md
# Production checklist (verify every value before exposing the API):
#                docs/deployment/production_checklist.md
# Compose file:  docker-compose.yml (canonical, no -f needed)
#                Pass `--env-file .env.selfhosted --env-file .env.db-admin`.
#
# Every abuse-control knob is on, docs are off, legacy routes require auth
# and internal IDs are hidden. Other machines reach TCKDB through the web UI
# port (TCKDB_WEB_BIND) or an ingress: the bundled Caddy or Cloudflare
# Tunnel (see the "Ingress" sections near the bottom), or your own nginx,
# Traefik, Tailscale or WireGuard.
# ============================================================================

# ============================================================================
# Must set
# ============================================================================

# Activates the startup safety guard. In `shared_private` and
# `hosted_public` the API refuses to boot when any of the required
# hosted settings below is at an unsafe value. Use `hosted_public`
# for internet-facing deployments, `shared_private` for lab-internal,
# and `local` for single-developer laptops (default if unset).
DEPLOYMENT_MODE=shared_private

# Restricted runtime database login used by the API and worker. It is set
# on the database role when the volume is first provisioned; changing it
# here later also needs the role changed (see .env.db-admin.example) or a
# fresh volume, or the API can no longer log in.
DB_PASSWORD=change-me-strong-runtime-db-password

# Credentials the API signs object-store requests with. The bundled
# SeaweedFS takes them as its admin identity.
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key

# Signs the tokens the SeaweedFS filer and volume server require before they
# read or write file content, which is what keeps other containers on the
# compose network out of the store's unauthenticated internal ports (#545).
# REQUIRED by the seaweedfs service: it refuses to start (exit 78) without
# one of at least 16 characters. A stack that runs only MinIO can leave it
# unset. Only the seaweedfs container uses it; the API never needs it.
# Generate one with
#     openssl rand -hex 32
SEAWEEDFS_JWT_KEY=change-me-openssl-rand-hex-32

# Secret that seals paging cursors (next_cursor / cursor=). REQUIRED: at least 32 characters, e.g.
#   openssl rand -hex 32
# Every API process must share it. Changing it invalidates cursors in flight (clients get 422 invalid_cursor
# and restart their traversal); nothing stored depends on it.
PAGING_CURSOR_KEY=

# Public base URL clients use. This is whatever hostname your ingress
# layer exposes.
TCKDB_PUBLIC_BASE_URL=https://api.tckdb.example.org/api/v1

# Trusted proxy header. Set this to the header your ingress layer
# injects unconditionally (and that an upstream client cannot forge).
#
# Choose the value to match your ingress:
#   Cloudflare Tunnel / Cloudflare proxy:  CF-Connecting-IP
#   the `caddy` profile, or the web UI
#   published on the lab network:          X-Real-IP
#   nginx (proxy_set_header X-Real-IP):    X-Real-IP
#   Traefik / Caddy with X-Forwarded-For:  X-Forwarded-For
#                                          (only if the proxy strips
#                                           any client-supplied value)
#
# Leave unset when no proxy that sets such a header sits in front of the API.
# TRUSTED_PROXY_HEADER=CF-Connecting-IP

# ============================================================================
# Tunables
# ============================================================================

# ----------------------------------------------------------------------------
# Published images and ports (docker-compose.yml, selfhost profile)
# ----------------------------------------------------------------------------
# Image tag for the API, init, worker and frontend: a release (0.4.1) or
# sha-<commit>. Every port binds to 127.0.0.1 only, except the web UI's,
# which binds to TCKDB_WEB_BIND, and Caddy's (see "Ingress" below).
# S3_CONSOLE_PORT is the MinIO console (`--profile minio`).
# Lab-network (TCKDB_WEB_BIND) and Caddy access need 0.3.0 or newer.
# TCKDB_IMAGE_TAG=0.4.1
# TCKDB_WEB_PORT=8011
# S3_PORT=9000
# S3_CONSOLE_PORT=9001

# Host address the web UI is published on. 127.0.0.1 keeps it on this
# machine; this machine's address on the lab network opens it to the lab.
# The database, the object store and the API port stay on 127.0.0.1.
# TCKDB_WEB_BIND=127.0.0.1

# Profiles `docker compose` starts when none is given on the command line:
# selfhost, plus caddy or cloudflare for the ingress below.
# COMPOSE_PROFILES=selfhost

# Compose project name. Volume names start with it (tckdb_tckdb_pgdata, ...),
# so a new release's bundle, unpacked into a new directory, finds the same
# data when this file is copied there. Unset, Compose uses the directory name.
COMPOSE_PROJECT_NAME=tckdb

# ----------------------------------------------------------------------------
# PostgreSQL (RDKit cartridge image)
# ----------------------------------------------------------------------------
# Bound to 127.0.0.1 only inside docker-compose.yml. Never expose 5432
# on the public interface.
#
# DB_HOST/DB_PORT are what a process on the host uses (Alembic, scripts, a
# host-run API): DB_PORT is also the port compose publishes on 127.0.0.1.
# Containers started by docker-compose.yml's selfhost profile or by
# tckdb_deploy.sh set their own DB_HOST=db, DB_PORT=5432.
# (See docs/deployment/troubleshooting.md, "host port vs container port".)
#
# DB_USER is deliberately the restricted API/worker login.  Keep the
# bootstrap administrator and migration-owner credentials in the separate
# operator-only .env.db-admin file; the systemd API unit must load only this
# runtime file.  Start Compose with both env files, in this order:
#   docker compose --env-file .env.selfhosted --env-file .env.db-admin up -d db seaweedfs
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tckdb
DB_USER=tckdb_app
DB_CLIENT_ENCODING=utf8

# Postgres session statement_timeout (ms). Belt-and-braces: the doc also
# sets this on the runtime role via `configure_database_roles.py apply`.
DB_STATEMENT_TIMEOUT_MS=30000

# ----------------------------------------------------------------------------
# S3 artifact storage
# ----------------------------------------------------------------------------
# SeaweedFS from docker-compose.yml by default, bound to 127.0.0.1 only and
# never published to the tunnel. Any S3-compatible service works instead
# (AWS S3; Google Cloud Storage via its S3 interoperability HMAC keys; an
# existing MinIO, started with `--profile minio`): set S3_ENDPOINT_URL and
# the keys to that service and do not start the seaweedfs service. The
# selfhost compose profile always uses the bundled SeaweedFS; an external
# store needs a host-run API or backend/scripts/ops/tckdb_deploy.sh.
#
# S3_ENDPOINT_URL is the address a host-run API uses. The selfhost profile's
# API container sets its own (http://seaweedfs:9000). tckdb_deploy.sh passes
# this file to its API container unchanged, so a file used there needs
# http://seaweedfs:9000 here.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=tckdb-artifacts
S3_REGION=us-east-1

# Optional. The SeaweedFS master, which the API asks for free disk and free
# volume slots after a write is refused with SeaweedFS's generic
# InternalError, and for the /status headroom warning. Unset, a full
# SeaweedFS is reported as "unavailable, retry later" (503) rather than full
# (507), and /status cannot warn before it fills. Set it only when the store
# is the `seaweedfs` service: the volume server is derived from it (same
# host, port 9340). An API container reaches it by service name once it is
# on the `<project>_storage` network (tckdb_deploy.sh: TCKDB_EXTRA_NETWORKS);
# an API on the host would need 9333 and 9340 published on 127.0.0.1, which
# docker-compose.yml does not do.
# S3_SEAWEEDFS_MASTER_URL=http://seaweedfs:9333

# Optional, read by backend/scripts/ops/tckdb_deploy.sh: extra Docker
# networks the API container joins. The bundled object store is reachable
# only on the `storage` network, so a containerised API using it needs:
# TCKDB_EXTRA_NETWORKS=tckdb_storage

# ----------------------------------------------------------------------------
# Hosted abuse-control posture (security phase 1)
# ----------------------------------------------------------------------------
# Master switch for the application-level rate limiter. MUST be true.
RATE_LIMIT_ENABLED=true

# Per-minute budgets. Buckets are split by route class.
# Conservative starting values; tune up only after observing
# legitimate-traffic patterns.
#
# Anonymous + authenticated public scientific reads.
RATE_LIMIT_ANON_READ_PER_MINUTE=60
RATE_LIMIT_AUTH_READ_PER_MINUTE=300
# Authenticated mutating routes (uploads, admin, etc.). Tight on
# purpose so one misbehaving uploader cannot exhaust the deployment.
RATE_LIMIT_AUTH_WRITE_PER_MINUTE=30
# POST /bundles/dry-run, which rehearses a full submit. Its own bucket,
# tighter than AUTH_WRITE.
RATE_LIMIT_BUNDLE_DRY_RUN_PER_MINUTE=10
# Caps on one contribution bundle, for /bundles/dry-run and /bundles/submit.
# Body size is refused (413) before the body is parsed; records (422) after.
# Both sit far above any measured bundle. 0 DISABLES a cap (negative is
# refused at startup). By contrast RATE_LIMIT_*=0 refuses every request.
BUNDLE_MAX_BODY_BYTES=5242880
BUNDLE_MAX_RECORDS=500
# Largest request body a caller with no valid API key or session may send
# (refused 413 anonymous_body_too_large before it is read). Default 1 MiB, the
# largest body an anonymous route needs apart from network export, which has
# its own cap. 0 disables it.
ANONYMOUS_MAX_BODY_BYTES=1048576
# Anonymous everything-else (including stray anonymous mutations).
# Smaller than ANON_READ so anonymous writes do not inherit the
# generous read budget.
RATE_LIMIT_ANON_OTHER_PER_MINUTE=20
# Auth-surface throttles (credential-stuffing / account-spam).
RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10

# Per-public-read query caps (defaults shown for documentation; uncomment
# to tighten further on a memory- or CPU-constrained host).
# PUBLIC_MAX_LIMIT=200
# PUBLIC_MAX_OFFSET=10000
# MAX_GEOMETRY_ATOMS_PUBLIC=500
# MAX_FULL_CALCULATIONS_PUBLIC=100
# MAX_FULL_GEOMETRIES_PUBLIC=100
# MAX_FULL_ARTIFACTS_PUBLIC=100

# Swagger UI, ReDoc and the OpenAPI schema, all three together.
# MUST be false for public deployments: /docs is an interactive request
# console pointed at this deployment.
EXPOSE_API_DOCS=false

# The read-only half of the above. With EXPOSE_API_DOCS=false, setting
# this true serves ReDoc at /redoc and the schema at /openapi.json, and
# still leaves /docs unregistered. Safe for a public deployment that
# wants its API contract discoverable. Defaults to false.
# EXPOSE_API_REFERENCE=true

# Legacy /api/v1/{thermo,kinetics,...} entity routes. MUST require auth
# in hosted deployments - they leak integer PKs.
LEGACY_READS_REQUIRE_AUTH=true

# Internal-ID visibility policy. MUST be false in hosted: clients use
# public refs as handles.
ALLOW_PUBLIC_INTERNAL_IDS=false

# Session cookie posture. `secure=true` requires that the ingress
# terminates TLS at the edge (Cloudflare Tunnel does this; nginx/Caddy
# with a managed cert do too). Set to false ONLY for testing a local
# HTTP-only setup.
#
# Browsers drop a Secure cookie served over plain HTTP from any host but
# localhost, so browser login then fails. A shared_private lab box reached
# over plain HTTP sets SESSION_COOKIE_SECURE=false together with
# SESSION_COOKIE_ALLOW_PLAIN_HTTP=true (the cookie then crosses the network
# unencrypted). hosted_public refuses SESSION_COOKIE_SECURE=false regardless.
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_ALLOW_PLAIN_HTTP=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true

# CORS - leave empty unless a known browser-app origin needs to call
# the API. An empty list disables the CORS middleware entirely, which
# is the correct hosted default.
# CORS_ALLOW_ORIGINS=https://app.tckdb.example.org
# CORS_ALLOW_CREDENTIALS=true

# ----------------------------------------------------------------------------
# Auth / registration policy
# ----------------------------------------------------------------------------
# Closed registration. Seed accounts via scripts/bootstrap_admin.py and
# the /admin invite flow.
AUTH_ALLOW_OPEN_REGISTRATION=false

# ----------------------------------------------------------------------------
# API binding and upload worker
# ----------------------------------------------------------------------------
# Bind to localhost only - the ingress layer (Cloudflare Tunnel,
# nginx, Caddy, ...) is the only thing that talks to the API. There
# is no router port-forward. TCKDB_API_PORT is also the loopback port
# the selfhost profile publishes the API container on.
TCKDB_API_HOST=127.0.0.1
TCKDB_API_PORT=8010

# Inline worker is acceptable for a small single-node deployment.
# Flip to false and run a separate worker unit if upload volume
# saturates the API process.
TCKDB_INLINE_WORKER=true

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# LOG_LEVEL: DEBUG / INFO / WARNING / ERROR. INFO is the recommended
# hosted default; raise to WARNING on a very memory-constrained host.
LOG_LEVEL=INFO

# LOG_FORMAT: `text` (human-readable, dev default) or `json` (one JSON
# object per line, includes request_id / level / logger / message /
# timestamp). Use `json` when logs are shipped to journald/ELK/Datadog
# or any structured log collector. Both formats include request_id when
# available.
LOG_FORMAT=json

# ----------------------------------------------------------------------------
# Ingress (OPTIONAL): Caddy, HTTPS with your domain name
# ----------------------------------------------------------------------------
# Used by the `caddy` Compose profile. Caddy publishes 80 and 443 on every
# interface and gets a Let's Encrypt certificate for TCKDB_DOMAIN, which needs
# a DNS record pointing at this host. Set TRUSTED_PROXY_HEADER=X-Real-IP.
# TCKDB_ACME_EMAIL is an optional contact address for the certificate
# authority. TCKDB_TLS=internal uses Caddy's own certificate authority, which
# browsers do not trust (testing only). TCKDB_HTTP_PORT / TCKDB_HTTPS_PORT move
# the host ports; Let's Encrypt can then only validate if a router forwards
# 80 and 443 to them.
#
# TCKDB_DOMAIN=tckdb.example.org
# TCKDB_ACME_EMAIL=admin@example.org
# TCKDB_TLS=internal
# TCKDB_HTTP_PORT=80
# TCKDB_HTTPS_PORT=443

# ----------------------------------------------------------------------------
# Ingress (OPTIONAL): Cloudflare Tunnel
# ----------------------------------------------------------------------------
# Required ONLY if you bring up the `cloudflared` service via the
# `cloudflare` Compose profile. nginx / Caddy / Traefik / Tailscale /
# WireGuard / a host-side cloudflared / etc. do not need this variable;
# they have their own config. Leave commented if you do not use the
# Compose cloudflared service.
#
# Provisioned out-of-band in the Cloudflare Zero Trust dashboard
# (Networks -> Tunnels -> Create a tunnel -> Cloudflared). Treat it
# like a long-lived bearer token; do not commit a populated value.
#
# CLOUDFLARED_TUNNEL_TOKEN=eyJhIjoi...   # from the Zero Trust UI
