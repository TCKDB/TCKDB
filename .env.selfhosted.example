# TCKDB self-host runtime settings (.env.selfhosted), the only file the API loads.
# Write it with backend/scripts/ops/tckdb_make_env.sh, which fills every secret.
# Do not commit the result. Guide: docs/deployment/README.md; before exposing
# the API, check docs/deployment/production_checklist.md.

# --- Required ---
# local, shared_private or hosted_public; the last two refuse to start on unsafe settings.
DEPLOYMENT_MODE=shared_private

# --- Secrets (generated by tckdb_make_env.sh; do not commit) ---
# API/worker database password. Changing it later also needs ALTER ROLE (see .env.db-admin.example).
DB_PASSWORD=change-me-strong-runtime-db-password
# Object-store credentials; the bundled SeaweedFS uses them as its admin login.
S3_ACCESS_KEY=change-me-s3-access-key
S3_SECRET_KEY=change-me-s3-secret-key
# Required by the seaweedfs service: 16+ characters (openssl rand -hex 32).
SEAWEEDFS_JWT_KEY=change-me-openssl-rand-hex-32
# Seals paging cursors: 32+ characters, the same in every API process.
PAGING_CURSOR_KEY=

# --- Public address ---
# URL clients reach the API at.
TCKDB_PUBLIC_BASE_URL=https://api.tckdb.example.org/api/v1
# Client-IP header your proxy always overwrites: X-Real-IP (web UI, caddy, nginx)
# or CF-Connecting-IP (Cloudflare). Leave unset with no proxy.
# TRUSTED_PROXY_HEADER=CF-Connecting-IP

# --- Images and ports ---
# Release tag of the TCKDB images, then the loopback ports of the web UI, S3 and MinIO console.
# TCKDB_IMAGE_TAG=0.4.1
# TCKDB_WEB_PORT=8011
# S3_PORT=9000
# S3_CONSOLE_PORT=9001

# Web UI address: 127.0.0.1, or this machine's lab-network address to open it to the lab.
# TCKDB_WEB_BIND=127.0.0.1

# Profiles started when none are given: selfhost, plus caddy or cloudflare.
# COMPOSE_PROFILES=selfhost

# Volume name prefix. Keep it when upgrading into a new directory, or the data is not found.
COMPOSE_PROJECT_NAME=tckdb

# --- Database ---
# How host-side processes reach Postgres (loopback only); containers use db:5432.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=tckdb
# Restricted runtime login; the admin and owner logins live in .env.db-admin.
DB_USER=tckdb_app
DB_CLIENT_ENCODING=utf8

# Statement timeout in milliseconds.
DB_STATEMENT_TIMEOUT_MS=30000

# --- Object store ---
# Host-side S3 address. Containers started by tckdb_deploy.sh need http://seaweedfs:9000.
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_BUCKET=tckdb-artifacts
S3_REGION=us-east-1

# Optional, bundled SeaweedFS only: lets the API report a full store (507) and warn before it fills.
# S3_SEAWEEDFS_MASTER_URL=http://seaweedfs:9333

# tckdb_deploy.sh only: extra networks for the API container (needed to reach the bundled store).
# TCKDB_EXTRA_NETWORKS=tckdb_storage

# --- Rate limits and request caps ---
# Must be true. A RATE_LIMIT_* budget of 0 refuses every request.
RATE_LIMIT_ENABLED=true

# Requests per minute, by route class.
RATE_LIMIT_ANON_READ_PER_MINUTE=60
RATE_LIMIT_AUTH_READ_PER_MINUTE=300
RATE_LIMIT_AUTH_WRITE_PER_MINUTE=30
RATE_LIMIT_BUNDLE_DRY_RUN_PER_MINUTE=10
# Contribution bundle size (bytes) and record caps; 0 disables a cap.
BUNDLE_MAX_BODY_BYTES=5242880
BUNDLE_MAX_RECORDS=500
# Largest body a caller without an API key or session may send; 0 disables.
ANONYMOUS_MAX_BODY_BYTES=1048576
# Anonymous requests other than reads.
RATE_LIMIT_ANON_OTHER_PER_MINUTE=20
RATE_LIMIT_AUTH_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_HOUR=10

# Optional caps on public reads (defaults shown).
# PUBLIC_MAX_LIMIT=200
# PUBLIC_MAX_OFFSET=10000
# MAX_GEOMETRY_ATOMS_PUBLIC=500
# MAX_FULL_CALCULATIONS_PUBLIC=100
# MAX_FULL_GEOMETRIES_PUBLIC=100
# MAX_FULL_ARTIFACTS_PUBLIC=100

# --- API surface ---
# Swagger UI, ReDoc and the OpenAPI schema. Must be false on a public deployment.
EXPOSE_API_DOCS=false

# Serves ReDoc and /openapi.json without /docs (default false).
# EXPOSE_API_REFERENCE=true

# Must be true when hosted: the legacy entity routes expose internal ids.
LEGACY_READS_REQUIRE_AUTH=true

# Must be false when hosted.
ALLOW_PUBLIC_INTERNAL_IDS=false

# --- Session cookies ---
# Needs HTTPS. Plain-HTTP lab servers: false plus SESSION_COOKIE_ALLOW_PLAIN_HTTP=true (not hosted_public).
SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_ALLOW_PLAIN_HTTP=true
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_HTTPONLY=true

# Browser-app origins allowed to call the API. Leave unset unless one needs to.
# CORS_ALLOW_ORIGINS=https://app.tckdb.example.org
# CORS_ALLOW_CREDENTIALS=true

# --- Accounts ---
# Closed registration: add users with the /admin invite flow.
AUTH_ALLOW_OPEN_REGISTRATION=false

# --- API process ---
# Keep on 127.0.0.1. TCKDB_API_PORT is also the selfhost API's loopback port.
TCKDB_API_HOST=127.0.0.1
TCKDB_API_PORT=8010

# Process uploads inside the API. Set false and add --profile worker for a separate worker.
TCKDB_INLINE_WORKER=true

# --- Logging ---
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# json (one object per line) or text.
LOG_FORMAT=json

# --- HTTPS with Caddy (--profile caddy; also set TRUSTED_PROXY_HEADER=X-Real-IP) ---
# Domain name; its DNS record must point at this host.
# TCKDB_DOMAIN=tckdb.example.org
# Optional contact address for Let's Encrypt.
# TCKDB_ACME_EMAIL=admin@example.org
# Use Caddy's own CA, which browsers do not trust (testing only).
# TCKDB_TLS=internal
# Host ports; Let's Encrypt must still reach them as 80 and 443.
# TCKDB_HTTP_PORT=80
# TCKDB_HTTPS_PORT=443

# --- Cloudflare Tunnel (--profile cloudflare) ---
# Token from the Zero Trust dashboard. A secret; do not commit it.
# CLOUDFLARED_TUNNEL_TOKEN=eyJhIjoi...   # from the Zero Trust UI
